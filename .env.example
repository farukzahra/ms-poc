# Azure AI (Microsoft Foundry / Azure OpenAI)
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_CHAT_DEPLOYMENT=
AZURE_EMBEDDING_DEPLOYMENT=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=enterprise-knowledge
AZURE_SEARCH_API_KEY=

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONNECTION_STRING=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Auth (Entra ID — deploy)
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Internal services (local Docker Compose)
MCP_SERVER_URL=http://localhost:8001
CRM_API_URL=http://localhost:8101
SALES_API_URL=http://localhost:8102
TICKETS_API_URL=http://localhost:8103
CONTRACTS_API_URL=http://localhost:8104
PRODUCTS_API_URL=http://localhost:8105

# RAG tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGIN=http://localhost:5200

# Dev auth (local only — replace with Entra in deploy)
DEV_AUTH_ENABLED=true
